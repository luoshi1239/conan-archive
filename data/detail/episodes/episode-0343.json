{"mangaRefs":["file-426-428"],"locationRefs":[],"summary":{"en":"Jodie is planning to leave, and Ran and Sonoko, stunned by the news, decide to throw her a going away party. They go into the store and find young woman named Aya being accused of shoplifting by her boss. They manage to come up with three possible suspects. Ran attempts to call Shinichi or Conan for help, since both are better at solving mysteries, but surprisingly, Jodie stops her and tells her to use her own deduction.","zhHans":"","zhHant":"","sourcePage":"The_Convenience_Store_Trap","sourceQuote":true},"characters":["character-shinichi-kudo","character-ran-mouri","character-conan-edogawa","character-ai-haibara","character-hiroshi-agasa","character-makoto-kyogoku","character-sonoko-suzuki","character-jodie-starling"],"organizations":[],"locations":[],"gadgets":[],"caseTypes":[],"sources":["src-abiting-conan-database","src-detective-conan-world-anime"],"detailStatus":"reviewed","coverage":{"directory":true,"basicFacts":true,"structure":true,"deepSpoilers":true},"raw":{"manga":"Vol. 42","specialLabel":null,"rawIndex":342,"dcwMangaSource":"V42 - F2~4(426-428)","dcwMangaKind":"manga","dcwAirDate":"December 1, 2003"},"season":8,"solvedByRaw":"Ran Mouri","solvedBy":"character-ran-mouri","castNames":["Conan Edogawa","Ran Mouri","Sonoko Suzuki","Jodie Starling","Ai Haibara","Hiroshi Agasa","Shinichi Kudo","Professor","Makoto Kyogoku"],"dcwL3Source":{"season":"The_Convenience_Store_Trap"}}