{"mangaRefs":["file-211-214"],"locationRefs":[],"summary":{"en":"Heiji and Kazuha visit Tokyo accompanied by Kogoro, Ran, and Conan. They run into the butler of Heiji's mother's late friend's family and are invited to their mansion. The son of the friend is getting married the next day. There a murder occurs and the butler is found dead in a locked room. It seems he was dragged to another room after being stabbed in the heart.","zhHans":"","zhHant":"","sourcePage":"The_Night_Before_the_Wedding_Locked_Room_Case","sourceQuote":true},"characters":["character-ran-mouri","character-kogoro-mouri","character-conan-edogawa","character-heiji-hattori","character-juzo-megure","character-wataru-takagi","character-kazuha-toyama","character-officer-tome"],"organizations":[],"locations":[],"gadgets":[],"caseTypes":[],"sources":["src-abiting-conan-database","src-detective-conan-world-anime"],"detailStatus":"reviewed","coverage":{"directory":true,"basicFacts":true,"structure":true,"deepSpoilers":true},"raw":{"manga":"Vol. 21~22","specialLabel":null,"rawIndex":140,"dcwMangaSource":"V21 - F11 ~ V22 - F1(211-212)","dcwMangaKind":"manga","dcwAirDate":"April 19, 1999"},"season":4,"solvedByRaw":"Conan Edogawa","solvedBy":"character-conan-edogawa","castNames":["Conan Edogawa","Heiji Hattori","Kogoro Mouri","Ran Mouri","Kazuha Toyama","Juzo Megure","Wataru Takagi","Officer Tome","Detective Yama","Shizuka Hattori","Reporter"],"dcwL3Source":{"season":"The_Night_Before_the_Wedding_Locked_Room_Case"}}