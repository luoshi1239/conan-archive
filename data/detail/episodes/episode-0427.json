{"mangaRefs":["file-505-507"],"locationRefs":[],"summary":{"en":"Mitsuhiko tells the Detective Boys that Shoko Amemiya, a girl that strongly resembles Haibara, is missing. Conan considers the possibility that the Black Organization kidnapped her and investigates. They learn that Amemiya's parents are gone for the week at a funeral and that Amemiya was spotted heading to a convenience store. Conan learns that Amemiya bought a large bottle of juice, powdered milk, and a X-Acto knife.","zhHans":"围绕水无怜奈、CIA、FBI和组织行动展开的长期情报战。","zhHant":"","legacy":true,"sourcePage":"Super_Secret_of_the_Road_to_School","sourceQuote":true},"characters":["character-gin","character-ai-haibara","character-ran-mouri","character-kogoro-mouri","character-conan-edogawa","character-vodka","character-vermouth","character-yumi-miyamoto","character-officer-numata","character-sumiko-kobayashi","character-tomoaki-araide","character-hidemi-hondou","character-eri-kisaki","character-asami-tsuburaya","character-hikaru-yasumoto"],"organizations":[],"locations":[],"gadgets":[],"caseTypes":[],"sources":["src-abiting-conan-database","src-detective-conan-world-anime","src-detective-conan-world-bo-timeline","src-detective-conan-world-cia"],"detailStatus":"reviewed","coverage":{"directory":true,"basicFacts":true,"structure":true,"deepSpoilers":true},"raw":{"manga":"Vol. 49","specialLabel":null,"rawIndex":426,"dcwMangaSource":"V49 - F5~7(505-507)","dcwMangaKind":"manga","dcwAirDate":"January 23, 2006"},"season":11,"solvedByRaw":"Conan Edogawa","solvedBy":"character-conan-edogawa","castNames":["Conan Edogawa","Ai Haibara","Detective Boys","Yumi Miyamoto","Tomoaki Araide","Ran Mouri","Kogoro Mouri","Sumiko Kobayashi","Asami Tsuburaya","Hikaru Yasumoto","Eri Kisaki","Gin","Vodka","Vermouth","Hidemi Hondou","Officer Numata"],"dcwL3Source":{"season":"Super_Secret_of_the_Road_to_School","characters":"Super_Secret_of_the_Road_to_School"}}