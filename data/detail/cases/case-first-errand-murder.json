{"summary":"少年侦探团追查一名孩子在废弃商店附近目击到的杀人案，案件起因与商店拆迁有关。","sources":["src-detective-conan-world-first-errand-case"],"relatedEpisodes":["episode-0059"],"culprit":{"zhHans":"村濑（Murase）。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"motive":{"zhHans":"村濑经营的商店即将被拆除，负责拆除的掮客要把店址推平；村濑因不愿失去商店而杀死了对方。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"method":{"zhHans":"村濑在废弃商店处杀害负责拆迁的掮客，并在孩子经过时误以为孩子看见了自己，从而试图灭口。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"evidence":{"zhHans":"村濑对孩子在废弃商店出现表现出异常恐惧；孩子只是去旧商店购买物品，并未真正看见杀人过程，村濑的反应反而暴露了其心理。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"resolution":{"zhHans":"柯南和少年侦探团救下孩子并揭示商店拆迁背景，村濑因意识到自己误判孩子目击情况而崩溃认罪。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"deepSpoilers":true,"detailStatus":"deepSpoilers","updatedAt":"2026-10-27","dcwPage":"The_First_Errand_Murder_Case","castNames":["Conan Edogawa","Detective Boys","Kogoro Mouri","Ran Mouri","Shinichi Kudo","Kamen Yaiba"],"solvedBy":"Conan Edogawa","dcwAirDate":"May 19, 1997","dcwFillerCaseNumber":"#22","locations":["Abandoned building"],"locationsSource":"The_First_Errand_Murder_Case","victims":[{"name":"The broker","causeOfDeath":"Blunt force trauma","causeOfDeathZh":"钝器伤致死","nameZh":"中间人"},{"name":"Hiroshi","nameZh":"广"}],"caseFactsSource":"The_First_Errand_Murder_Case","locationsZh":["废弃建筑"]}