{"summary":"插画家长野泉死亡后被伪装成自杀，柯南从蝴蝶标记、绘画署名和阳台机关追查花冈健仁。","sources":["src-detective-conan-world-illustrator-case"],"relatedEpisodes":["episode-0060"],"culprit":{"zhHans":"花冈健仁（Kenjin Hanaoka）。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"motive":{"zhHans":"长野泉是花冈的幽灵画师和秘密情人，花冈的大部分作品实际由她创作；泉要求他离婚并以揭露关系和代笔事实施压，花冈因此失控杀人。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"method":{"zhHans":"花冈用水晶烟灰缸击打泉致死，把尸体倚在阳台并用鱼线、花盆和门上的钉子组成机关；开门后花盆脱落，鱼线和尸体被拉向排水口，制造自杀假象。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"evidence":{"zhHans":"泉作品中的蝴蝶标记、花冈脚趾甲上被指甲油留下的蝴蝶标记，以及阳台鱼线机关共同指向花冈；花冈声称从未到过现场也与机关矛盾。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"resolution":{"zhHans":"柯南通过蝴蝶标记和阳台机关揭穿花冈伪造自杀的计划，花冈最终承认因泉要求他面对婚姻和代笔事实而杀人。","en":null,"translationStatus":"human","translationSourceHash":"da39a3ee5e6b"},"deepSpoilers":true,"detailStatus":"deepSpoilers","updatedAt":"2026-10-27","dcwPage":"An_Illustrator_Murder_Case","castNames":["Conan Edogawa","Kogoro Mouri","Ran Mouri","Juzo Megure"],"solvedBy":"Kogoro Mouri (via Conan)","dcwAirDate":"May 26, 1997","dcwMangaCaseNumber":"#35","locations":["Chono household"],"locationsSource":"An_Illustrator_Murder_Case","victims":[{"name":"Izumi Chono","age":"25 years old","causeOfDeath":"Blunt force trauma","causeOfDeathZh":"钝器伤致死","nameZh":"蝶野泉"}],"caseFactsSource":"An_Illustrator_Murder_Case","locationsZh":["蝶野家"]}